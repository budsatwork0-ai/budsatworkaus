{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Bud Bridge",
      "type": "shell",
      "command": "node scripts/bud-bridge.js",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^NEVER_MATCHES$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Bud Bridge running",
          "endsPattern": "^NEVER_ENDS$"
        }
      }
    }
  ]
}
